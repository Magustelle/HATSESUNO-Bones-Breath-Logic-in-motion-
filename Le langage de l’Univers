def _unpack(name):
    return zlib.decompress(base64.b85decode(''.join(EMBEDDED[name]))).decode('utf-8')

def _load_modules(workspace):
    for name in ('render_matter', 'render_v2', 'render_v3', 'render_v4_3d',
                 'render_v5_material', 'render_v6_volume'):
        mod=types.ModuleType(name)
        mod.__file__=str(workspace/(name+'.py'))
        mod.__package__=''
        sys.modules[name]=mod
        exec(compile(_unpack(name), mod.__file__, 'exec'), mod.__dict__)
    return sys.modules

def main():
    ap=argparse.ArgumentParser(description='The Matter Between — SINGLE-FILE mathematical renderer')
    ap.add_argument('--generation',choices=['G56','G57','G58','G59','G60','G61'],default='G61')
    ap.add_argument('--width',type=int,default=2200)
    ap.add_argument('--height',type=int,default=1375)
    ap.add_argument('--outdir',type=Path,default=Path.cwd())
    args=ap.parse_args()
    if min(args.width,args.height)<128: ap.error('Dimensions must be at least 128px')
    args.outdir.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='matter_between_') as temporary:
        home=Path(temporary)
        (home/'g52_cognition_results.json').write_text(_unpack('g52_cognition_results.json'),encoding='utf8')
        m=_load_modules(home)
        data=home/'g52_cognition_results.json'
        if args.generation=='G56':
            m['render_matter'].field_image(data,args.outdir/'matter_between_G56.png',args.width,args.height)
        elif args.generation=='G57':
            m['render_v2'].render(data,args.outdir/'matter_between_G57.png',args.width,args.height)
        elif args.generation=='G58':
            m['render_v3'].render(data,args.outdir/'matter_between_G58.png',args.width,args.height)
        elif args.generation=='G59':
            m['render_v4_3d'].render(data,args.outdir/'matter_between_G59.png',args.width,args.height)
        elif args.generation=='G60':
            m['render_v5_material'].run(data,args.outdir/'matter_between_G60.png',args.width,args.height)
        else:
            # G61's original run reads a local ROOT from its original module;
            # point it to the embedded input workspace and write output externally.
            meta=m['render_v6_volume'].run(args.width,args.height,True,args.outdir)
            print(json.dumps(meta,indent=2))
        print('Generation:', args.generation)
        print('Output folder:',args.outdir.resolve())

if __name__=='__main__': main()

